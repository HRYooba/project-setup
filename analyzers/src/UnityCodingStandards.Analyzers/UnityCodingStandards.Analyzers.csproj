<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <AssemblyName>UnityCodingStandards.Analyzers</AssemblyName>
    <RootNamespace>UnityCodingStandards.Analyzers</RootNamespace>
    <!-- Unity 6000.3 / 6000.4 が同梱する Roslyn は 4.3.1。
         参照をそれより新しくすると Unity 側の csc が analyzer を読み込めず、
         「違反ゼロ」に見えて実際は走っていない状態になる。上げるときは
         Editor/Data/DotNetSdkRoslyn/Microsoft.CodeAnalysis.CSharp.dll の版を確認してから。 -->
    <MicrosoftCodeAnalysisVersion>4.3.0</MicrosoftCodeAnalysisVersion>
    <!-- RS1033 は説明文の末尾を ASCII の句読点で判定するため、日本語の説明が通らない。
         規則 ID の台帳（RS2008 のリリース追跡）は抑制せず AnalyzerReleases.*.md で満たす。 -->
    <NoWarn>$(NoWarn);RS1033</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 規則 ID の台帳。新しい ID を足してここへ書き忘れると RS2008 でビルドが落ちる。 -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
